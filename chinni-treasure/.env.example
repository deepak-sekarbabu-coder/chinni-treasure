# Database
# DATABASE_URL is used at runtime by Prisma Client (via the pg pool).
# DIRECT_URL is used by Prisma CLI for migrations / introspection.
DATABASE_URL=postgresql://user:password@localhost:5432/chinni_treasure
DIRECT_URL=postgresql://user:password@localhost:5432/chinni_treasure

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# Razorpay (Standard Checkout)
# Secret is server-only and must NEVER be exposed to the client.
RAZORPAY_KEY_ID=rzp_test_TCG5Fwn7sCs8Fd
RAZORPAY_KEY_SECRET=7BFbETTFM4kqTYWamJP7J0Yh
# Public key exposed to the browser (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_TCG5Fwn7sCs8Fd

# Image Optimization
# Set to "true" to disable Next.js image optimization entirely.
# Useful when your Vercel free-tier quota is exhausted.
# FallbackImage will render plain <img> tags instead.
# NEXT_PUBLIC_IMAGE_UNOPTIMIZED=true

# Redis (Redis Cloud free tier, TCP) — optional. Powers shared rate limiting
# (login) and the admin stats cache across serverless instances. Without it the
# app falls back to in-memory stores (per-instance; fine for local dev, weak on
# Vercel). The connection string is provided by your Redis provider dashboard
# (format: redis://[username]:[password]@[host]:[port]).
# REDIS_URL="redis://default:your-password@your-host.db.redis.io:11285"

# Axiom (observability) — see https://axiom.co/docs/send-data/nextjs
# The @axiomhq/nextjs SDK ships structured logs (page traffic via proxy.ts,
# route-level events, Web Vitals, and unhandled request errors) to Axiom.
# Free tier: ~0.5-1 TB/month ingestion with 30-day retention.
# 1) Create a dataset + API token at https://axiom.co
# 2) Set these in Vercel -> Settings -> Environment Variables (all envs)
# NEXT_PUBLIC_* means the token ships to the browser for Web Vitals + client
# logs — Axiom recommends an ingest-only token scoped to the dataset.
# Without these vars the app runs exactly as before (logger is a no-op /
# console fallback), so they are optional locally.
NEXT_PUBLIC_AXIOM_TOKEN=your-axiom-ingest-token
NEXT_PUBLIC_AXIOM_DATASET=chinni-treasure
# Ingest edge domain for your account/region — find it in the Axiom UI
# (Settings -> Data) or via: curl -H "Authorization: Bearer <token>" \
#   https://api.axiom.co/v1/datasets  (field: edgeDeploymentUrl host)
# Example for the eu-central-1 cloud:
# NEXT_PUBLIC_AXIOM_EDGE=eu-central-1.aws.edge.axiom.co

# Vercel Cron Jobs
# Protects /api/cron/db-health (keep-alive ping for the Nhost free-tier
# inactivity pause). Vercel sends Authorization: Bearer <CRON_SECRET> on cron
# requests automatically when this var is set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=generate-a-long-random-string
