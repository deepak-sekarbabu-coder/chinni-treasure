# Database
# DATABASE_URL is used at runtime by Prisma Client (via the pg pool).
# DIRECT_URL is used by Prisma CLI for migrations / introspection.
DATABASE_URL=postgresql://user:password@localhost:5432/chinni_treasure
DIRECT_URL=postgresql://user:password@localhost:5432/chinni_treasure

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# Razorpay (Standard Checkout)
# Secret is server-only and must NEVER be exposed to the client.
RAZORPAY_KEY_ID=rzp_test_TCG5Fwn7sCs8Fd
RAZORPAY_KEY_SECRET=7BFbETTFM4kqTYWamJP7J0Yh
# Public key exposed to the browser (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_TCG5Fwn7sCs8Fd

# Image Optimization
# Set to "true" to disable Next.js image optimization entirely.
# Useful when your Vercel free-tier quota is exhausted.
# FallbackImage will render plain <img> tags instead.
# NEXT_PUBLIC_IMAGE_UNOPTIMIZED=true

# Redis (Redis Cloud free tier, TCP) — optional. Powers shared rate limiting
# (login) and the admin stats cache across serverless instances. Without it the
# app falls back to in-memory stores (per-instance; fine for local dev, weak on
# Vercel). The connection string is provided by your Redis provider dashboard
# (format: redis://[username]:[password]@[host]:[port]).
# REDIS_URL="redis://default:your-password@your-host.db.redis.io:11285"
