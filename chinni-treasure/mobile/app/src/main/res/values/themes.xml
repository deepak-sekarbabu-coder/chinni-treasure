<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark, no action bar. windowBackground is what shows through the forced
        edge-to-edge status bar on Android 15, so it must match the brand black
        token or the page will flash white on cold start.
    -->
    <style name="Theme.ChinniTreasure" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_black</item>
        <item name="android:colorBackground">@color/brand_black</item>
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>