{
  "name": "chinni-treasure",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:static-dynamic && npx prisma generate && next build",
    "start": "next start",
    "lint": "npm run check:static-dynamic && eslint",
    "lint:fix": "eslint --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:setup": "npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts",
    "data:export": "npx tsx scripts/export-to-excel.ts",
    "data:import": "npx tsx scripts/generate-seed-from-excel.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:static-dynamic": "node scripts/check-static-dynamic.mjs",
    "clean": "node -e \"const{rmSync}=require('fs');['.next','.turbo','node_modules'].forEach(d=>{try{rmSync(d,{recursive:true,force:true});console.log('Removed '+d)}catch{}})\"",
    "clean:cache": "node -e \"const{rmSync}=require('fs');['.next','.turbo'].forEach(d=>{try{rmSync(d,{recursive:true,force:true});console.log('Removed '+d)}catch{}})\"",
    "clean:all": "npm run clean && npm install",
    "compose:build": "podman compose build",
    "compose:up": "podman compose up -d",
    "compose:down": "podman compose down",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "lighthouse:desktop": "node scripts/run-lighthouse.mjs --desktop",
    "lighthouse:analyze": "node scripts/analyze-lighthouse.mjs",
    "lighthouse:report": "node scripts/open-lighthouse-report.mjs",
    "postinstall": "prisma generate",
    "fallow": "npx fallow",
    "fallow:report": "node scripts/run-fallow-report.mjs"
  },
  "dependencies": {
    "@axiomhq/js": "^1.8.0",
    "@axiomhq/logging": "^0.4.0",
    "@axiomhq/nextjs": "^0.4.0",
    "@axiomhq/react": "^0.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.9",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "next": {
      "postcss": "8.5.26"
    },
    "@hono/node-server": "1.19.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "isomorphic-dompurify": "^3.19.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
