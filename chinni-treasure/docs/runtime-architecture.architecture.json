  "cards": [
    {
      "dot": "cyan",
      "title": "Storefront runtime",
      "items": [
        "Guest cart via React Context + localStorage, synced to a signed cart cookie for SSR hydration",
        "React Query v5 caches server state; order confirmation exports PDF invoice + barcode",
        "Tracking portal resolves by order number or phone, served from the order cache"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data and API governance",
      "items": [
        "Zod v4 schemas validate every /api input and output; OpenAPI spec at /api/docs",
        "Serializable transactions and versioned order transitions; rejection restores stock",
        "Cache ownership split across catalogue / order / stats caches; Redis with in-memory fallback"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "proxy.ts guards /admin/* with jose-verified JWT in an HttpOnly session cookie; bcrypt passwords",
        "CSRF origin + referer checks and rate-limited login; admin mutations verify the same JWT",
        "Razorpay HMAC-SHA256 signature verification runs server-side only"
      ]
    },
    {
      "dot": "violet",
      "title": "Operations",
      "items": [
        "Axiom structured logging for page traffic, route events, Web Vitals, and errors",
        "Daily /api/cron/db-health keep-alive; Vercel Analytics + Speed Insights",
        "Admin Excel export is cursor-batched; Lighthouse budgets live in lighthouse/budgets.json"
      ]
    }
  ]
